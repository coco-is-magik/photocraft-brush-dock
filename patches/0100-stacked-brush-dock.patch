+/// The existing controls inside a normal, resizable dock group.
+pub fn attached(app: &mut PhotocraftApp, ui: &mut egui::Ui) {
+    if !app.ui.panels.brush_settings || !app.ui.panels.brush_attached {
+        return;
+    }
+    app.ui.brush_tab = app.ui.dock_tabs.brushes.min(1);
+    if app.ui.brush_tab == 1 {
+        crate::brushes_tab::show(app, ui);
+    } else {
+        egui::ScrollArea::vertical().id_salt("attached-brush-settings").auto_shrink([false, false]).show(ui, |ui| settings_tab(app, ui));
+    }
+}
+
+fn content(app: &mut PhotocraftApp, ui: &mut egui::Ui) {
+    ui.horizontal(|ui| {
+        for (i, name) in [tl!("Brush Settings"), tl!("Brushes")].iter().enumerate() {
+            if widgets::pill_tab(ui, name, app.ui.brush_tab == i).clicked() {
+                app.ui.brush_tab = i;
+            }
+        }
+    });
+    widgets::hairline(ui);
+    if app.ui.brush_tab == 1 {
+        crate::brushes_tab::show(app, ui);
+    } else {
+        settings_tab(app, ui);
+    }
+}
