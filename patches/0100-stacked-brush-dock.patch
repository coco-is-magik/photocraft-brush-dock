+#[test]
+fn attached_brush_panel_closes_without_changing_brush() {
+    use egui_kittest::kittest::Queryable;
+    let mut h = attachment_harness();
+    let brush = h.state().session.tools.brush.clone();
+    h.get_by_label("Attach to right sidebar").click();
+    h.run_steps(4);
+    brush_group_menu(&mut h);
+    h.get_by_label("Close Tab Group").click();
+    h.run_steps(4);
+    assert!(!h.state().ui.panels.brush_settings);
+    assert!(h.query_by_label("Float").is_none());
+    assert_eq!(h.state().session.tools.brush, brush);
+}
