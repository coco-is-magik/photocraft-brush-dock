+        let height = rect_of(&h, Group::Brushes).height();
+        let dock_left = color.left() - if theme == ThemeKind::ProMedium { 2.0 } else { 8.0 };
+        drag(&mut h, pos2(dock_left, 500.0), pos2(dock_left - 100.0, 500.0));
+        let wider = rect_of(&h, Group::Brushes);
+        assert!(wider.width() > brushes.width() + 70.0, "{theme:?}: {brushes:?} -> {wider:?}");
+        assert_eq!(wider.x_range(), rect_of(&h, Group::Layers).x_range());
+        assert_eq!(wider.height(), height);
+        let saved = h.state().session.prefs().panel_layout.clone();
+        let (mut restored, _, _) = app_with_layers();
+        apply(&mut restored, &saved);
+        assert_eq!(restored.ui.dock.height(Group::Brushes), h.state().ui.dock.height(Group::Brushes));
+        assert!(restored.ui.panels.brush_attached);
+    }
+}
+
+#[test]
+fn attached_brushes_reopen_after_collapse_and_tab_close() {
+    let (mut app, _, _) = app_with_layers();
+    app.ui.panels.brush_attached = true;
+    app.ui.dock.set_collapsed(Group::Brushes, true);
+    app.ui.dock.hide_tab(Group::Brushes, 1, true);
+    let ctx = egui::Context::default();
+    crate::menus::invoke(&mut app, &ctx, "window.panel.brushes", json!({})).unwrap();
+    assert!(Group::Brushes.shown(&app.ui.panels));
+    assert!(!app.ui.dock.is_collapsed(Group::Brushes));
+    assert_eq!(app.ui.dock.visible_tabs(Group::Brushes, true), vec![(0, "Brush Settings"), (1, "Brushes")]);
+    app.ui.dock.set_collapsed(Group::Brushes, true);
+    crate::menus::invoke(&mut app, &ctx, "window.toggle.brushSettings", json!({})).unwrap();
+    assert!(Group::Brushes.shown(&app.ui.panels));
+    assert!(!app.ui.dock.is_collapsed(Group::Brushes));
+    assert_eq!(app.ui.dock_tabs.brushes, 0);
+}
+
+#[test]
+fn attached_brush_settings_do_not_expand_or_move_the_dock() {
+    let (mut app, _, _) = app_with_layers();
+    app.ui.panels.brush_settings = true;
+    app.ui.panels.brush_attached = true;
+    app.ui.brush_tab = 1;
+    app.ui.dock_tabs.brushes = 1;
+    let mut h = harness(app, vec2(1366.0, 768.0), ThemeKind::ProMedium);
+    for width in [250.0, 380.0, 520.0] {
+        crate::panels::request_dock_width(&h.ctx, width);
+        h.run_steps(4);
+        let rects = last_rects(&h.ctx);
+        h.state_mut().ui.brush_tab = 0;
+        h.state_mut().ui.dock_tabs.brushes = 0;
+        for section in 0..crate::brush_panel::SECTIONS.len() {
+            h.state_mut().ui.brush_section = section;
+            h.run_steps(3);
+            assert_eq!(last_rects(&h.ctx), rects, "section {section} at width {width}");
+        }
+        h.state_mut().ui.brush_tab = 1;
+        h.state_mut().ui.dock_tabs.brushes = 1;
+    }
 }
 
