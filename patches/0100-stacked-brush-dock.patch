+#[test]
+fn brush_attachment_round_trips_and_old_layouts_stay_floating() {
+    let panels = crate::state::Panels { brush_attached: true, brush_settings: true, ..Default::default() };
+    let mut saved = serde_json::to_value(&panels).unwrap();
+    let restored: crate::state::Panels = serde_json::from_value(saved.clone()).unwrap();
+    assert!(restored.brush_attached);
+    assert!(restored.brush_settings);
+    saved.as_object_mut().unwrap().remove("brush_attached");
+    let legacy: crate::state::Panels = serde_json::from_value(saved.clone()).unwrap();
+    assert!(!legacy.brush_attached);
+    saved["brush_attached"] = json!("invalid");
+    assert!(serde_json::from_value::<crate::state::Panels>(saved).is_err());
+}
+
+#[test]
+fn remembered_layout_restores_brush_attachment() {
+    let mut original = app();
+    original.ui.panels.brush_settings = true;
+    original.ui.panels.brush_attached = true;
+    original.session.prefs.edit(|p| p.workspace.remember_workspace_changes = true);
+    let ctx = egui::Context::default();
+    crate::dock::persist(&mut original, &ctx);
+    let saved = original.session.prefs().panel_layout.clone();
+    let mut restored = app();
+    crate::dock::apply(&mut restored, &saved);
+    assert!(restored.ui.panels.brush_settings);
+    assert!(restored.ui.panels.brush_attached);
+}
