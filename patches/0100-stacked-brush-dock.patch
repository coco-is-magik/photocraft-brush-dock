+    );
+    PhotocraftApp::setup_context(&h.ctx, crate::theme::ThemeKind::default());
+    h.run_steps(4);
+    h
+}
+
+fn brush_group_menu(h: &mut Harness<'static, PhotocraftApp>) {
+    let strip = crate::dock::last_strips(&h.ctx).into_iter().find(|s| s.group == crate::dock::Group::Brushes).unwrap();
+    let pos = strip.menu.center();
+    h.event(egui::Event::PointerMoved(pos));
+    h.event(egui::Event::PointerButton { pos, button: egui::PointerButton::Primary, pressed: true, modifiers: egui::Modifiers::NONE });
+    h.run_steps(1);
+    h.event(egui::Event::PointerButton { pos, button: egui::PointerButton::Primary, pressed: false, modifiers: egui::Modifiers::NONE });
+    h.run_steps(3);
+}
+
+#[test]
+fn brush_window_attaches_without_taking_extra_canvas_width_and_floats_again() {
+    use egui_kittest::kittest::Queryable;
+    let mut h = attachment_harness();
+    let initial_width = h.state().last_canvas_rect.width();
+    h.get_by_label("Attach to right sidebar").click();
+    h.run_steps(4);
+    assert!(h.state().ui.panels.brush_attached);
+    assert_eq!(h.state().last_canvas_rect.width(), initial_width);
+    let groups = crate::dock::last_rects(&h.ctx);
+    let color = groups.iter().position(|(g, _)| *g == crate::dock::Group::Color).unwrap();
+    assert_eq!(groups[color + 1].0, crate::dock::Group::Brushes);
+    assert!(h.query_by_label("Attach to right sidebar").is_none());
+    brush_group_menu(&mut h);
+    h.get_by_label("Float").click();
+    h.run_steps(4);
+    assert!(!h.state().ui.panels.brush_attached);
+    assert_eq!(h.state().last_canvas_rect.width(), initial_width);
+    assert!(h.state().ui.panels.brush_settings);
+}
